aws_region       = "ap-southeast-1"             # Region AWS Singapore
project_name     = "web-bansach"               # Tên dự án dùng đặt tên tài nguyên
instance_type    = "t3.small"                  # Loại VPS EC2
key_name         = "your-existing-aws-keypair" # Tên key pair đã tạo trên AWS
allowed_ssh_cidr = "YOUR_PUBLIC_IP/32"         # IP máy bạn được phép SSH/kubectl