[k3s_master]
vps1 ansible_host=${master_public_ip} private_ip=${master_private_ip}

[k3s_workers]
%{ for index, ip in worker_public_ips ~}
vps${index + 2} ansible_host=${ip}
%{ endfor ~}

[k3s_cluster:children]
k3s_master
k3s_workers

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=/root/.ssh/web-bansach-key.pem
ansible_python_interpreter=/usr/bin/python3
