# ============================================================
# WebBanSach - Docker Compose production environment template


# ------------------------------------------------------------
# Public URLs / domain
# ------------------------------------------------------------
# Frontend domain users open in browser.
APP_FRONTEND_URL=http://hoanghh.xyz

# Backend API public domain.
APP_BACKEND_URL=http://api.hoanghh.xyz

# Comma-separated allowed frontend origins for CORS.
APP_CORS_ALLOWED_ORIGINS=http://hoanghh.xyz

# Vite embeds this value while building the frontend image.
VITE_API_BASE_URL=http://api.hoanghh.xyz

# Host port exposed by frontend Nginx.
FRONTEND_PORT=80

# Optional monitoring ports.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ------------------------------------------------------------
# Docker images
# ------------------------------------------------------------
# Leave these defaults when building images locally on the VPS.
BACKEND_IMAGE=web-bansach-backend:latest
FRONTEND_IMAGE=web-bansach-frontend:latest

# ------------------------------------------------------------
# MySQL
# ------------------------------------------------------------
MYSQL_DATABASE=DUAN_WEBBANSACH
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_MYSQL_PASSWORD

SPRING_DATASOURCE_USERNAME=root
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_DATABASE=0

# ------------------------------------------------------------
# RabbitMQ
# ------------------------------------------------------------
RABBITMQ_USERNAME=web_bansach
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBITMQ_PASSWORD

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
# Use a long random string, at least 32 characters.
APP_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_FOR_HS256
APP_JWT_EXPIRATION=1800000

# ------------------------------------------------------------
# Gmail SMTP
# ------------------------------------------------------------
# GMAIL_APP_PASSWORD is a Google App Password, not your Gmail login password.
GMAIL_USERNAME=CHANGE_ME_GMAIL_USERNAME
GMAIL_APP_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD

# ------------------------------------------------------------
# Cloudinary
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=CHANGE_ME_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=CHANGE_ME_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=CHANGE_ME_CLOUDINARY_API_SECRET

# ------------------------------------------------------------
# SePay
# ------------------------------------------------------------
SEPAY_BANK_CODE=MB
SEPAY_ACCOUNT_NUMBER=CHANGE_ME_SEPAY_ACCOUNT_NUMBER
SEPAY_ACCOUNT_NAME=CHANGE_ME_SEPAY_ACCOUNT_NAME
SEPAY_PAYMENT_TEMPLATE=compact
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
SEPAY_WEBHOOK_API_KEY=CHANGE_ME_SEPAY_WEBHOOK_API_KEY
SEPAY_RETURN_URL=http://hoanghh.xyz/payment-result

# ------------------------------------------------------------
# Grafana
# ------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD
