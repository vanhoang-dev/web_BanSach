# ============================================================
# WebBanSach - local environment template
# Copy to .env.local, then run:
# docker compose --env-file .env.local up --build

# ------------------------------------------------------------
# Local URLs
# ------------------------------------------------------------
APP_FRONTEND_URL=http://localhost:3000
APP_BACKEND_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3307
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ------------------------------------------------------------
# MySQL
# ------------------------------------------------------------
MYSQL_DATABASE=DUAN_WEBBANSACH
MYSQL_ROOT_PASSWORD=root_password
SPRING_DATASOURCE_USERNAME=root
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_PASSWORD=redis_password
REDIS_DATABASE=0

# ------------------------------------------------------------
# RabbitMQ
# ------------------------------------------------------------
RABBITMQ_USERNAME=web_bansach
RABBITMQ_PASSWORD=web_bansach_password

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
APP_JWT_SECRET=local-dev-secret-key-change-before-production-32chars
APP_JWT_EXPIRATION=1800000

# ------------------------------------------------------------
# Optional integrations for local
# ------------------------------------------------------------
GMAIL_USERNAME=noreply@webbansach.local
GMAIL_APP_PASSWORD=
MANAGEMENT_HEALTH_MAIL_ENABLED=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SEPAY_BANK_CODE=MB
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=SEPAY JSC
SEPAY_PAYMENT_TEMPLATE=compact
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
SEPAY_WEBHOOK_API_KEY=
SEPAY_RETURN_URL=http://localhost:3000/payment-result
